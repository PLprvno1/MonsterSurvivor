<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/gold_mid"
                android:centerColor="@color/gold_dark"
                android:endColor="#5C3E08" />
            <stroke
                android:width="2dp"
                android:color="@color/gold_border" />
            <corners android:radius="8dp" />
            <padding
                android:bottom="6dp"
                android:left="16dp"
                android:right="16dp"
                android:top="10dp" />
        </shape>
    </item>
</layer-list>
