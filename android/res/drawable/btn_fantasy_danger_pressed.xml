<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/danger_red"
                android:centerColor="@color/danger_dark"
                android:endColor="#4A0E0E" />
            <stroke
                android:width="2dp"
                android:color="@color/danger_red" />
            <corners android:radius="6dp" />
            <padding
                android:bottom="6dp"
                android:left="14dp"
                android:right="14dp"
                android:top="10dp" />
        </shape>
    </item>
</layer-list>
