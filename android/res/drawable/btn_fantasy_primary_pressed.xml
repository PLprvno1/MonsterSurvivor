<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/forest_primary"
                android:centerColor="@color/forest_primary_dark"
                android:endColor="#0A1C13" />
            <stroke
                android:width="2dp"
                android:color="@color/forest_border" />
            <corners android:radius="6dp" />
            <padding
                android:bottom="6dp"
                android:left="14dp"
                android:right="14dp"
                android:top="10dp" />
        </shape>
    </item>
</layer-list>
