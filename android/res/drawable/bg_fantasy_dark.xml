<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep arcane purple base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1E1030"
                android:centerColor="#0F0818"
                android:endColor="#07030C" />
        </shape>
    </item>
    <!-- Mystical purple atmospheric radial glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:centerX="0.5"
                android:centerY="0.3"
                android:startColor="#267B39BD"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
