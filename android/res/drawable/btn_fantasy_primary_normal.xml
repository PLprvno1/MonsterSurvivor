<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/forest_primary_dark" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/forest_primary_light"
                android:centerColor="@color/forest_primary"
                android:endColor="@color/forest_primary_dark" />
            <stroke
                android:width="2dp"
                android:color="@color/forest_border" />
            <corners android:radius="6dp" />
            <padding
                android:bottom="8dp"
                android:left="14dp"
                android:right="14dp"
                android:top="8dp" />
        </shape>
    </item>
</layer-list>
