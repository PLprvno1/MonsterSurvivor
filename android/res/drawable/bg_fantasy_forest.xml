<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep dark forest base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0D2218"
                android:centerColor="#07130E"
                android:endColor="#040A07" />
        </shape>
    </item>
    <!-- Mystical emerald atmospheric radial glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:centerX="0.5"
                android:centerY="0.3"
                android:startColor="#262D7351"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Subtle top vignette -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#55000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
