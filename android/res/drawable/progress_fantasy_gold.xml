<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="#3307130D" />
            <stroke android:width="1dp" android:color="@color/card_border_unselected" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="4dp" />
                <gradient
                    android:startColor="@color/gold_dark"
                    android:centerColor="@color/gold_mid"
                    android:endColor="@color/gold_bright"
                    android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
