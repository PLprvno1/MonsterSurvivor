<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_pause_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC08140F"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_fantasy_frame"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_pause"
            app:tint="@color/gold_bright" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result_pause_title"
            android:textColor="@color/gold_bright"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Buttons Stack -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_pause_resume"
            style="@style/Widget.MonsterSurvivor.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_primary"
            android:layout_marginBottom="8dp"
            android:drawableStart="@drawable/ic_sword"
            android:text="@string/btn_resume" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_pause_settings"
            style="@style/Widget.MonsterSurvivor.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_secondary"
            android:layout_marginBottom="8dp"
            android:drawableStart="@drawable/ic_settings"
            android:text="@string/btn_settings" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_pause_give_up"
            style="@style/Widget.MonsterSurvivor.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_secondary"
            android:drawableStart="@drawable/ic_exit"
            android:text="@string/btn_give_up" />

    </LinearLayout>

</LinearLayout>
