<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_fantasy_forest">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_item_shop" style="@style/Widget.MonsterSurvivor.Toolbar"
        android:layout_width="0dp" android:layout_height="@dimen/toolbar_height"
        android:background="#D90C1A14" app:title="@string/title_item_shop"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_shop_wallet" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:background="@drawable/panel_fantasy_badge"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="7dp" android:paddingBottom="7dp"
        android:textColor="@color/gold_bright" android:textSize="14sp" android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/toolbar_item_shop" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="0dp" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_shop_wallet" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="6dp" app:cardBackgroundColor="#D91A2B20" app:strokeColor="#887B633A" app:strokeWidth="1dp" app:cardCornerRadius="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="10dp">
                <ImageView android:id="@+id/iv_shop_health" android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_potion_health" android:contentDescription="@string/potion_health_name" />
                <TextView android:id="@+id/tv_shop_health_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/gold_bright" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_shop_health_desc" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <TextView android:id="@+id/tv_shop_health_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/gold_bright" android:textSize="12sp" />
                <TextView android:id="@+id/tv_shop_health_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_shop_health" style="@style/Widget.MonsterSurvivor.Button.Gold" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:text="@string/shop_buy" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" app:cardBackgroundColor="#D91A2B20" app:strokeColor="#887B633A" app:strokeWidth="1dp" app:cardCornerRadius="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="10dp">
                <ImageView android:id="@+id/iv_shop_speed" android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_potion_speed" android:contentDescription="@string/potion_speed_name" />
                <TextView android:id="@+id/tv_shop_speed_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/gold_bright" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_shop_speed_desc" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <TextView android:id="@+id/tv_shop_speed_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/gold_bright" android:textSize="12sp" />
                <TextView android:id="@+id/tv_shop_speed_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_shop_speed" style="@style/Widget.MonsterSurvivor.Button.Gold" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:text="@string/shop_buy" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" app:cardBackgroundColor="#D91A2B20" app:strokeColor="#887B633A" app:strokeWidth="1dp" app:cardCornerRadius="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="10dp">
                <ImageView android:id="@+id/iv_shop_cooldown" android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_potion_cooldown" android:contentDescription="@string/potion_cooldown_name" />
                <TextView android:id="@+id/tv_shop_cooldown_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/gold_bright" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_shop_cooldown_desc" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <TextView android:id="@+id/tv_shop_cooldown_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/gold_bright" android:textSize="12sp" />
                <TextView android:id="@+id/tv_shop_cooldown_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_shop_cooldown" style="@style/Widget.MonsterSurvivor.Button.Gold" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:text="@string/shop_buy" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
