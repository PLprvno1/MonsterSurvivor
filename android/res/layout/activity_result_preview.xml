<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fantasy_forest"
    tools:context=".android.ResultPreviewActivity">

    <!-- Top Toolbar with Back button -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_preview"
        style="@style/Widget.MonsterSurvivor.Toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/toolbar_height"
        android:background="#D90C1A14"
        android:elevation="6dp"
        app:title="XEM TRƯỚC GIAO DIỆN KẾT QUẢ / PAUSE"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Control bar at top to toggle previews -->
    <LinearLayout
        android:id="@+id/layout_preview_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_preview">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_show_victory"
            style="@style/Widget.MonsterSurvivor.Button.Gold"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="VICTORY"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_show_gameover"
            style="@style/Widget.MonsterSurvivor.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="GAME OVER"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_show_pause"
            style="@style/Widget.MonsterSurvivor.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="PAUSE"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Container where the preview layout is loaded -->
    <FrameLayout
        android:id="@+id/frame_preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_preview_tabs" />

</androidx.constraintlayout.widget.ConstraintLayout>
