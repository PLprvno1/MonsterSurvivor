<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/achievements_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fantasy_forest"
    tools:context=".android.AchievementsActivity">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_achievements"
        style="@style/Widget.MonsterSurvivor.Toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/toolbar_height"
        android:background="#D90C1A14"
        android:elevation="6dp"
        app:title="@string/title_achievements"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Progress Summary Header in Landscape -->
    <LinearLayout
        android:id="@+id/layout_ach_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/panel_fantasy_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_achievements">

        <TextView
            android:id="@+id/tv_ach_progress_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiến độ: 0 / 6 Thành Tích (0%)"
            android:textColor="@color/gold_bright"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_achievements"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:max="8"
            android:progress="0"
            android:progressDrawable="@drawable/progress_fantasy_gold" />

    </LinearLayout>

    <!-- Empty State Banner (Shown when no matches have been completed yet) -->
    <LinearLayout
        android:id="@+id/panel_ach_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/panel_fantasy_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_ach_header">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_info"
            app:tint="@color/gold_bright"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ach_empty_title"
                android:textColor="@color/gold_bright"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ach_empty_desc"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scroll Area for Lifetime Stats & Achievements List -->
    <ScrollView
        android:id="@+id/scroll_achievements"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="6dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/panel_ach_empty_state">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <!-- Section 1 Header: Lifetime Records -->
            <TextView
                android:id="@+id/tv_heading_lifetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ach_section_lifetime"
                android:textColor="@color/gold_bright"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Row 1: 3 Cards (Time, Kills, Victories) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <!-- Card 1: Best Time -->
                <LinearLayout
                    android:id="@+id/card_ach_best_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/panel_fantasy_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/gold_bright" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/ach_best_time"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_val_best_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="00:00"
                        android:textColor="@color/gold_bright"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ach_best_time_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Card 2: Total Kills -->
                <LinearLayout
                    android:id="@+id/card_ach_kills"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/panel_fantasy_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_skull"
                            app:tint="@color/gold_bright" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/ach_total_kills"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_val_total_kills"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="@color/gold_bright"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ach_total_kills_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Card 3: Total Victories -->
                <LinearLayout
                    android:id="@+id/card_ach_victories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/panel_fantasy_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_crown"
                            app:tint="@color/gold_bright" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/ach_victories"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_val_victories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="@color/gold_bright"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ach_victories_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: 2 Cards (Matches, Boss Defeated) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Card 4: Total Matches -->
                <LinearLayout
                    android:id="@+id/card_ach_matches"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/panel_fantasy_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_gamepad"
                            app:tint="@color/gold_bright" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/ach_matches"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_val_matches"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="@color/gold_bright"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ach_matches_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Card 5: Boss Defeated -->
                <LinearLayout
                    android:id="@+id/card_ach_boss"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/panel_fantasy_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_sword"
                            app:tint="@color/gold_bright" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/ach_boss"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_val_boss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ach_boss_status_none"
                        android:textColor="@color/gold_bright"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ach_boss_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Secondary Lifetime Statistics Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/panel_fantasy_card"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_sparkles"
                    app:tint="@color/gold_bright"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_ach_extra_stats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Section 2 Header: Hero Achievements List -->
            <TextView
                android:id="@+id/tv_heading_achievements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ach_section_list"
                android:textColor="@color/gold_bright"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Achievements Grid Row 1 (Item 1 & Item 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <!-- Item 1: First Blood -->
                <LinearLayout
                    android:id="@+id/card_ach_item_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/panel_fantasy_card"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_ach_item_1_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_sword"
                        app:tint="@color/text_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_ach_item_1_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ach_item_first_blood_title"
                            android:textColor="@color/gold_bright"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ach_item_1_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ach_item_first_blood_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tv_ach_item_1_prog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 1"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_ach_item_1_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/panel_fantasy_badge_locked"
                        android:text="@string/ach_status_locked"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Item 2: Novice Survivor -->
                <LinearLayout
                    android:id="@+id/card_ach_item_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/panel_fantasy_card"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_ach_item_2_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/text_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_ach_item_2_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ach_item_novice_survivor_title"
                            android:textColor="@color/gold_bright"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ach_item_2_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ach_item_novice_survivor_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tv_ach_item_2_prog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00 / 05:00"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_ach_item_2_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/panel_fantasy_badge_locked"
                        android:text="@string/ach_status_locked"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Achievements Grid Row 2 (Item 3 & Item 4) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <!-- Item 3: Monster Slayer -->
                <LinearLayout
                    android:id="@+id/card_ach_item_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/panel_fantasy_card"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_ach_item_3_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_skull"
                        app:tint="@color/text_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_ach_item_3_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ach_item_monster_slayer_title"
                            android:textColor="@color/gold_bright"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ach_item_3_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ach_item_monster_slayer_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tv_ach_item_3_prog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 100"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_ach_item_3_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/panel_fantasy_badge_locked"
                        android:text="@string/ach_status_locked"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Item 4: Centurion Slayer -->
                <LinearLayout
                    android:id="@+id/card_ach_item_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/panel_fantasy_card"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_ach_item_4_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_sparkles"
                        app:tint="@color/text_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_ach_item_4_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ach_item_centurion_slayer_title"
                            android:textColor="@color/gold_bright"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ach_item_4_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ach_item_centurion_slayer_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tv_ach_item_4_prog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 1000"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_ach_item_4_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/panel_fantasy_badge_locked"
                        android:text="@string/ach_status_locked"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Achievements Grid Row 3 (Item 5 & Item 6) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Item 5: Bane of Lich Lord -->
