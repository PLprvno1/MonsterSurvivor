<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <uses-feature android:glEsVersion="0x00020000" android:required="true"/>
  <uses-feature android:name="android.hardware.type.pc" android:required="false" />

  <application
      android:allowBackup="true"
      android:fullBackupContent="true"
      android:icon="@drawable/ic_launcher"
      android:isGame="true"
      android:appCategory="game"
      android:label="@string/app_name"
      tools:ignore="UnusedAttribute"
      android:theme="@style/Theme.MonsterSurvivor.Forest">

    <!-- Primary Launcher Entry Point: HomeActivity -->
    <activity
        android:name="com.example.monstersurvivor.android.HomeActivity"
        android:label="@string/app_name"
        android:launchMode="singleTask"
        android:screenOrientation="landscape"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
        android:theme="@style/Theme.MonsterSurvivor.Forest"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>

    <!-- Game Mode Selection Screen -->
    <activity
        android:name="com.example.monstersurvivor.android.GameModeActivity"
        android:label="@string/title_mode_select"
        android:screenOrientation="landscape"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
        android:theme="@style/Theme.MonsterSurvivor.Forest"
        android:exported="false" />

    <activity
        android:name="com.example.monstersurvivor.android.ItemShopActivity"
        android:label="@string/title_item_shop"
        android:screenOrientation="landscape"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
        android:theme="@style/Theme.MonsterSurvivor.Forest"
        android:exported="false" />

    <!-- Settings Screen -->
    <activity
        android:name="com.example.monstersurvivor.android.SettingsActivity"
        android:label="@string/title_settings"
        android:screenOrientation="landscape"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
        android:theme="@style/Theme.MonsterSurvivor.Forest"
        android:exported="false" />

    <!-- Achievements Screen -->
    <activity
        android:name="com.example.monstersurvivor.android.AchievementsActivity"
        android:label="@string/title_achievements"
        android:screenOrientation="landscape"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
        android:theme="@style/Theme.MonsterSurvivor.Forest"
        android:exported="false" />

    <!-- How To Play Screen -->
    <activity
        android:name="com.example.monstersurvivor.android.HowToPlayActivity"
        android:label="@string/title_how_to_play"
        android:screenOrientation="landscape"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
        android:theme="@style/Theme.MonsterSurvivor.Forest"
        android:exported="false" />

    <!-- Result / Pause Screens Preview (For Demo & Grading) -->
    <activity
        android:name="com.example.monstersurvivor.android.ResultPreviewActivity"
        android:label="UI Preview"
        android:screenOrientation="landscape"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
        android:theme="@style/Theme.MonsterSurvivor.Forest"
        android:exported="false" />

    <!-- Core libGDX Gameplay Activity (Kept Intact) -->
    <activity
        android:name="com.example.monstersurvivor.android.AndroidLauncher"
        android:label="@string/app_name"
        android:screenOrientation="landscape"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
        android:theme="@style/GdxTheme"
        android:exported="true" />

  </application>

</manifest>
